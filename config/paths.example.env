# Copy to a local .env file or define these variables in your shell.
# Never commit real paths, credentials, or data.
CHARLS_PROJECT_ROOT=/path/to/authorized/charls/project
CHARLS_DATA_ROOT=/path/to/authorized/charls/data
CHARLS_ITEM_MAP_FILE=/path/to/local/ADL_IADL_ITEM_LEVEL_CODE_MAP.csv
CHARLS_PRIMARY_OUTPUT=/path/to/local/output/charls_primary
CHARLS_EXTENSION_OUTPUT=/path/to/local/output/charls_extensions
ELSA_PROJECT_ROOT=/path/to/authorized/elsa/project
ELSA_DATA_ROOT=/path/to/authorized/elsa/stata/files
ELSA_PHASE1_ROOT=/path/to/local/elsa/phase_elsa1
ELSA_PHASE2_ROOT=/path/to/local/elsa/phase_elsa2
ELSA_PROTOCOL_V11_ROOT=/path/to/local/elsa/protocol_v1_1
ELSA_PROTOCOL_V12_ROOT=/path/to/local/elsa/protocol_v1_2
ELSA_DOCUMENT_TEXT_ROOT=/path/to/local/elsa/document_text
ELSA_OUTPUT_ROOT=/path/to/local/output/elsa
CHARLS_PRIMARY_RESULT_FILE=/path/to/local/charls/PRIMARY_CONTINUOUS_MODEL_RESULTS.csv
FIGURE_OUTPUT_ROOT=/path/to/local/output/figures
